{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "mobile-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mobilenext/mobile-mcp@1.0.17"
        ],
        "environment": {
          "MOBILEMCP_DISABLE_TELEMETRY": "1"
        }
      }
    }
  }
}
